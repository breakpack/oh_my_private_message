FROM node:22-alpine
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev && mkdir -p /data && chown node:node /data
COPY privatecat-test-user.js ./
USER node
ENV PRIVATECAT_RELAY_URL=ws://privatecat-relay:8080/relay
ENV PRIVATECAT_TEST_PEER_DATA_DIR=/data
CMD ["node", "privatecat-test-user.js"]
